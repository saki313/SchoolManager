        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <activity
            android:name=".ui.note.AjouterCoursActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.etudiant.AddEditEtudiantActivity"
            android:exported="false" />
        <activity
            android:name=".ui.etudiant.EtudiantDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.note.NoteListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.presence.PrisePresenceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.emploi.EmploiTempsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.etudiant.HistoriqueEtudiantActivity"
            android:exported="false" />
        <activity
            android:name=".ui.emploi.HistoriqueParDateActivity"
            android:exported="false" />
    </application>

</manifest>